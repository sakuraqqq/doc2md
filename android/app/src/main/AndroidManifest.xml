<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 卡 059 / B018：用本 App 打开 .md（系统「打开方式」）。
                 只收 content://（ACTION_VIEW + DEFAULT）；⛔ 不收 file://（API<29 需存储权限、29+ 分区存储同样读不到 ⇒ 与零新增权限冲突）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="text/x-markdown" />
                <data android:scheme="content" android:mimeType="text/plain" />
            </intent-filter>

            <!-- 兜底：文件管理器常把 .md 报成 */* 或 octet-stream ⇒ 用 */* + pathPattern 接过，但 ⛔ 不声明裸 */*（无 pathPattern）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\.md" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\..*\.md" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\.markdown" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\..*\.markdown" />
            </intent-filter>

        </activity>

        <!-- 卡 013 / A1：FileProvider 的 <provider> 已**删除**（连同 res/xml/file_paths.xml）。
             原因：模板默认的 <external-path name="my_images" path="." /> 把**整个外部存储**暴露给该 provider，
             而全仓**零调用者**（卡 012 §八 与卡 013 A1 两次独立复核）⇒ "真正需要的子路径" = 空集 ⇒ 删除是唯一实现。
             守卫 = 契约组 Z5（不补断言的话，删前删后都"绿" —— 那不叫守）。 -->
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
